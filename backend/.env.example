# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Database (Postgres, self-hosted on Hetzner in prod) ---
# Port 5433 because this dev machine already has a native PostgreSQL service
# on 5432; the docker-compose "db" service is published on 5433 for that
# reason. Inside docker-compose, the backend container overrides this to
# point at db:5432 instead (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://yam:yam@127.0.0.1:5433/yam

# --- Photo storage ---
# "local": saves uploads to MEDIA_ROOT on disk and serves them from this
#   process — no OCI account needed, use this for development.
# "oci": uploads go straight to OCI Object Storage via presigned URLs —
#   use this in production. Set the OCI_* vars below in that case.
STORAGE_BACKEND=local
MEDIA_ROOT=media
# This backend's own externally-reachable origin (only used by the local
# backend, to build upload/read URLs).
PUBLIC_BASE_URL=http://localhost:8000

# --- Object storage (OCI Object Storage, S3-compatible API) — prod only ---
# Endpoint format: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_REGION=sa-saopaulo-1
OCI_ACCESS_KEY_ID=your-customer-secret-key-id
OCI_SECRET_ACCESS_KEY=your-customer-secret-key
OCI_BUCKET_NAME=yam-photos
# Optional: public base URL if the bucket/CDN serves reads directly
OCI_PUBLIC_BASE_URL=
